# Public origin of the landing page (canonical links, hreflang, sitemap, social cards).
VITE_SITE_URL=https://your-domain.example

# Store listings. Leave empty until the app is live there: the button then says "Coming soon".
# e.g. https://apps.apple.com/app/qolha/id<app-id>
VITE_APP_STORE_URL=
# e.g. https://play.google.com/store/apps/details?id=com.ahmedhashem.ma7fazty
VITE_PLAY_STORE_URL=
